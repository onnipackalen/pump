{
  "name": "pump",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p . && npm run typecheck --workspaces --if-present",
    "rtp": "npm run rtp --workspace @pump/engine",
    "sim": "npm run sim --workspace @pump/engine --",
    "hammer": "npm run hammer --workspace @pump/server --",
    "dev": "tsx dev.ts",
    "start": "npm run build && npm run start --workspace @pump/server",
    "dev:server": "npm run dev --workspace @pump/server",
    "dev:web": "npm run dev --workspace @pump/web",
    "build": "npm run build --workspace @pump/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
